<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="QuickMindMap.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:QuickMindMap"
    xmlns:views="using:QuickMindMap.Views"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Quick MindMap">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootShellGrid">
        <!-- Library View (Home) -->
        <views:LibraryView x:Name="MainLibraryView" Visibility="Visible" />

        <!-- Editor View (Canvas) -->
        <views:EditorView x:Name="MainEditorView" Visibility="Collapsed" />
    </Grid>
</Window>
