<UserControl
    x:Class="QuickMindMap.Views.EditorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:controls="using:QuickMindMap.Controls"
    xmlns:vm="using:QuickMindMap.ViewModels"
    mc:Ignorable="d">

    <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Editor Command Bar -->
        <Border Grid.Row="0"
                Background="{ThemeResource LayerFillColorDefaultBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                Padding="8,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Back Button, Title, and Save Status -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="BtnBack" ToolTipService.ToolTip="Back to Library" Click="OnBackClick" Padding="8,6">
                        <FontIcon Glyph="&#xE72B;" FontSize="14" />
                    </Button>

                    <TextBox x:Name="TxtMapTitle"
                             Width="200"
                             FontWeight="SemiBold"
                             FontSize="14"
                             BorderThickness="0,0,0,1"
                             Background="Transparent"
                             PlaceholderText="Map Title"
                             VerticalAlignment="Center"
                             TextChanged="OnMapTitleChanged" />

                    <!-- Save Status Indicator -->
                    <Border Background="{ThemeResource SubtleFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE73E;" FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock x:Name="TxtSaveStatus" Text="Saved" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Center: Editing, Formatting, and Layout Tools -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Undo / Redo -->
                    <Button x:Name="BtnUndo" ToolTipService.ToolTip="Undo (Ctrl+Z)" Click="OnUndoClick" Padding="6,4">
                        <FontIcon Glyph="&#xE7A7;" FontSize="14" />
                    </Button>
                    <Button x:Name="BtnRedo" ToolTipService.ToolTip="Redo (Ctrl+Y)" Click="OnRedoClick" Padding="6,4">
                        <FontIcon Glyph="&#xE7A6;" FontSize="14" />
                    </Button>

                    <AppBarSeparator />

                    <!-- Node Add Tools -->
                    <Button x:Name="BtnAddChild" ToolTipService.ToolTip="Add Child (Tab)" Click="OnAddChildClick" Padding="8,4">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE710;" FontSize="14" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                            <TextBlock Text="Child" FontSize="14" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnAddSibling" ToolTipService.ToolTip="Add Sibling (Enter)" Click="OnAddSiblingClick" Padding="8,4">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE74B;" FontSize="14" />
                            <TextBlock Text="Sibling" FontSize="14" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnDeleteNode" ToolTipService.ToolTip="Delete (Del)" Click="OnDeleteClick" Padding="6,4">
                        <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    </Button>

                    <AppBarSeparator />

                    <!-- Font Formatting Tools -->
                    <Button x:Name="BtnDecreaseFont" ToolTipService.ToolTip="Decrease Font Size" Click="OnDecreaseFontClick" Padding="6,4">
                        <FontIcon Glyph="&#xE738;" FontSize="14" />
                    </Button>
                    <Button x:Name="BtnIncreaseFont" ToolTipService.ToolTip="Increase Font Size" Click="OnIncreaseFontClick" Padding="6,4">
                        <FontIcon Glyph="&#xE710;" FontSize="14" />
                    </Button>

                    <ToggleButton x:Name="ToggleBold" ToolTipService.ToolTip="Bold" Click="OnToggleBoldClick" Padding="6,4">
                        <TextBlock Text="B" FontWeight="Bold" FontSize="14" />
                    </ToggleButton>

                    <ToggleButton x:Name="ToggleItalic" ToolTipService.ToolTip="Italic" Click="OnToggleItalicClick" Padding="6,4">
                        <TextBlock Text="I" FontStyle="Italic" FontSize="14" />
                    </ToggleButton>

                    <ToggleButton x:Name="ToggleStrikethrough" ToolTipService.ToolTip="Strikethrough" Click="OnToggleStrikethroughClick" Padding="6,4">
                        <TextBlock Text="S" TextDecorations="Strikethrough" FontSize="14" />
                    </ToggleButton>

                    <AppBarSeparator />

                    <!-- Shape Picker Dropdown -->
                    <DropDownButton ToolTipService.ToolTip="Node Shape" Padding="8,4">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE734;" FontSize="14" />
                            <TextBlock Text="Shape" FontSize="14" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem Text="Rounded Rectangle" Click="OnShapeSelectClick" Tag="RoundedRectangle" />
                                <MenuFlyoutItem Text="Pill" Click="OnShapeSelectClick" Tag="Pill" />
                                <MenuFlyoutItem Text="Rectangle" Click="OnShapeSelectClick" Tag="Rectangle" />
                                <MenuFlyoutItem Text="Ellipse" Click="OnShapeSelectClick" Tag="Ellipse" />
                                <MenuFlyoutItem Text="Underline" Click="OnShapeSelectClick" Tag="Underline" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <!-- Color Palette Flyout -->
                    <DropDownButton ToolTipService.ToolTip="Branch Color &amp; Palette" Padding="8,4">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE790;" FontSize="14" />
                            <TextBlock Text="Color" FontSize="14" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <Flyout Placement="Bottom">
                                <StackPanel Spacing="10" Width="220" Padding="4">
                                    <TextBlock Text="Color Theme Palette" FontWeight="SemiBold" FontSize="14" />
                                    <ComboBox x:Name="ComboPalette" HorizontalAlignment="Stretch" SelectionChanged="OnPaletteSelectionChanged" />

                                    <TextBlock Text="Node Color" FontWeight="SemiBold" FontSize="14" Margin="0,4,0,0" />
                                    <VariableSizedWrapGrid x:Name="ToolbarColorGrid" MaximumRowsOrColumns="4" ItemWidth="34" ItemHeight="34" />
                                </StackPanel>
                            </Flyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <!-- Icon / Emoji Picker -->
                    <DropDownButton ToolTipService.ToolTip="Node Icon / Sticker" Padding="8,4">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="⭐" FontSize="14" />
                            <TextBlock Text="Icon" FontSize="14" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <Flyout Placement="Bottom">
                                <StackPanel Spacing="8" Width="200" Padding="4">
                                    <TextBlock Text="Select Icon" FontWeight="SemiBold" FontSize="14" />
                                    <VariableSizedWrapGrid MaximumRowsOrColumns="4" ItemWidth="36" ItemHeight="36">
                                        <Button Content="💡" Click="OnIconSelectClick" Tag="💡" Margin="2" Padding="0" Width="32" Height="32" />
                                        <Button Content="⭐" Click="OnIconSelectClick" Tag="⭐" Margin="2" Padding="0" Width="32" Height="32" />
                                        <Button Content="🎯" Click="OnIconSelectClick" Tag="🎯" Margin="2" Padding="0" Width="32" Height="32" />
                                        <Button Content="✅" Click="OnIconSelectClick" Tag="✅" Margin="2" Padding="0" Width="32" Height="32" />
                                        <Button Content="⚠️" Click="OnIconSelectClick" Tag="⚠️" Margin="2" Padding="0" Width="32" Height="32" />
                                        <Button Content="📌" Click="OnIconSelectClick" Tag="📌" Margin="2" Padding="0" Width="32" Height="32" />
                                        <Button Content="🔥" Click="OnIconSelectClick" Tag="🔥" Margin="2" Padding="0" Width="32" Height="32" />
                                        <Button Content="🚀" Click="OnIconSelectClick" Tag="🚀" Margin="2" Padding="0" Width="32" Height="32" />
                                        <Button Content="📚" Click="OnIconSelectClick" Tag="📚" Margin="2" Padding="0" Width="32" Height="32" />
                                        <Button Content="💼" Click="OnIconSelectClick" Tag="💼" Margin="2" Padding="0" Width="32" Height="32" />
                                        <Button Content="⏱️" Click="OnIconSelectClick" Tag="⏱️" Margin="2" Padding="0" Width="32" Height="32" />
                                        <Button Content="❌" ToolTipService.ToolTip="Clear Icon" Click="OnIconSelectClick" Tag="" Margin="2" Padding="0" Width="32" Height="32" />
                                    </VariableSizedWrapGrid>
                                </StackPanel>
                            </Flyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <!-- Node Note Editor Button -->
                    <DropDownButton ToolTipService.ToolTip="Node Note / Details" Padding="8,4">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE70F;" FontSize="14" />
                            <TextBlock Text="Note" FontSize="14" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <Flyout Placement="Bottom">
                                <StackPanel Spacing="8" Width="260" Padding="4">
                                    <TextBlock Text="Topic Notes" FontWeight="SemiBold" FontSize="14" />
                                    <TextBox x:Name="TxtNodeNote"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             Height="100"
                                             PlaceholderText="Add detailed notes or descriptions..."
                                             TextChanged="OnNodeNoteChanged" />
                                </StackPanel>
                            </Flyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <AppBarSeparator />

                    <!-- Layout & Line Style -->
                    <DropDownButton ToolTipService.ToolTip="Layout Structure" Padding="8,4">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE8D2;" FontSize="14" />
                            <TextBlock Text="Layout" FontSize="14" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem Text="Dual-Sided Mind Map" Click="OnLayoutSelectClick" Tag="MindMap" />
                                <MenuFlyoutItem Text="Right-Tree Layout" Click="OnLayoutSelectClick" Tag="RightOnly" />
                                <MenuFlyoutItem Text="Left-Tree Layout" Click="OnLayoutSelectClick" Tag="LeftOnly" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem Text="Smooth Curved Lines" Click="OnLineStyleSelectClick" Tag="BezierCurved" />
                                <MenuFlyoutItem Text="Stepped Orthogonal Lines" Click="OnLineStyleSelectClick" Tag="RoundedStep" />
                                <MenuFlyoutItem Text="Straight Direct Lines" Click="OnLineStyleSelectClick" Tag="StraightLine" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                </StackPanel>

                <!-- Right: Export, Fullscreen, Save, Help -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <!-- Export Dropdown -->
                    <DropDownButton ToolTipService.ToolTip="Export Map" Padding="8,5">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xEDE1;" FontSize="14" />
                            <TextBlock Text="Export" FontSize="14" />
                        </StackPanel>
                        <DropDownButton.Flyout>
                            <MenuFlyout Placement="Bottom">
                                <MenuFlyoutItem Text="Export as PNG Image..." Click="OnExportPngClick">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xEB9F;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Export as Quick MindMap (.m8map)..." Click="OnExportJsonClick">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B9;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Export as Markdown Outline (.md)..." Click="OnExportMarkdownClick">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A5;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Export as OPML Outline (.opml)..." Click="OnExportOpmlClick">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE81E;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem Text="Export as Plain Text (.txt)..." Click="OnExportPlainTextClick">
                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8A5;" /></MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>

                    <Button x:Name="BtnSave" Style="{ThemeResource AccentButtonStyle}" ToolTipService.ToolTip="Save Now (Ctrl+S)" Click="OnSaveClick" Padding="10,5">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE74E;" FontSize="14" />
                            <TextBlock Text="Save" FontSize="14" FontWeight="SemiBold" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnFullscreen" ToolTipService.ToolTip="Fullscreen (F11)" Click="OnFullscreenClick" Padding="8,5">
                        <FontIcon Glyph="&#xE740;" FontSize="14" />
                    </Button>

                    <Button ToolTipService.ToolTip="Shortcuts &amp; Guide (?)" Click="OnHelpClick" Padding="8,5">
                        <FontIcon Glyph="&#xE897;" FontSize="14" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Mind Map Canvas Element -->
        <controls:MindMapCanvasControl x:Name="MapCanvas" Grid.Row="1" />
    </Grid>
</UserControl>
